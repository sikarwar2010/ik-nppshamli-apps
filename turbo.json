{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "PORT",
    "NODE_ENV",
    "CORS_ORIGIN",
    "SESSION_SECRET",
    "SESSION_COOKIE_NAME",
    "SESSION_IDLE_TTL",
    "SESSION_ABSOLUTE_TTL",
    "SESSION_IDLE_TIMEOUT_SECONDS",
    "SESSION_ABSOLUTE_TIMEOUT_SECONDS",
    "CSRF_COOKIE_NAME",
    "BETTER_AUTH_SECRET",
    "PUBLIC_APP_URL",
    "SEED_ADMIN_EMAIL",
    "SEED_ADMIN_NAME",
    "SEED_ADMIN_PASSWORD",
    "DATABASE_URL",
    "REDIS_URL",
    "API_INTERNAL_URL",
    "API_BUILD_ID",
    "GIT_SHA",
    "COMMIT_SHA",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_CITIZEN_WEB_URL",
    "STORAGE_DIR",
    "PAYMENT_PROVIDER",
    "REQUEST_BODY_LIMIT",
    "OBSERVE_APP_KEY",
    "OBSERVE_APP_SECRET",
    "ATOM_RETURN_URL",
    "ATOM_CALLBACK_URL",
    "ATOM_GATEWAY_RETURN_URL",
    "ATOM_BASE_URL",
    "ATOM_MERCH_ID",
    "ATOM_PASSWORD",
    "ATOM_API_SECRET_KEY",
    "ATOM_AES_REQUEST_KEY",
    "ATOM_AES_REQUEST_IV",
    "ATOM_AES_RESPONSE_KEY",
    "ATOM_AES_RESPONSE_IV",
    "ATOM_REQ_HASH_KEY",
    "ATOM_RESP_HASH_KEY",
    "ATOM_PRODUCT",
    "ATOM_AUTH_URL",
    "ATOM_CHECKOUT_ENV",
    "ATOM_CHECKOUT_CDN",
    "STORAGE_SIGNING_SECRET",
    "ARGON2_MEMORY_KB",
    "ARGON2_TIME_COST",
    "ARGON2_PARALLELISM",
    "STORAGE_NAME",
    "ULB_CODE",
    "IMPORT_MAX_FILE_SIZE_MB",
    "CI",
    "PLAYWRIGHT_BASE_URL",
    "STORAGE_DRIVER",
    "MINIO_ENDPOINT",
    "MINIO_PORT",
    "MINIO_USE_SSL",
    "MINIO_ACCESS_KEY",
    "MINIO_SECRET_KEY",
    "MINIO_BUCKET",
    "MINIO_REGION",
    "MINIO_TEST_ENDPOINT",
    "MINIO_TEST_PORT",
    "MINIO_TEST_ACCESS_KEY",
    "MINIO_TEST_SECRET_KEY",
    "SURVEY_PARCEL_DIGITS",
    "IMAGE_MIGRATION_ALLOWED_HOSTS",
    "IMAGE_MIGRATION_MAX_BYTES",
    "NEXT_PUBLIC_ULB_CODE",
    "NEXT_PUBLIC_ULB_NAME",
    "NEXT_PUBLIC_SITE_ID",
    "SITE_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    },
    "e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
