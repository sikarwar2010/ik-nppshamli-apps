# Leave empty for same-origin /api rewrite to Nest (recommended with Docker).
# NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Citizen website (apps/web) — staff links to online property tax pay.
NEXT_PUBLIC_CITIZEN_WEB_URL=http://localhost:3001
# Prefer 127.0.0.1 over localhost on Windows (Nest listens on IPv4 0.0.0.0).
API_INTERNAL_URL=http://127.0.0.1:4000
# BFF wait for multipart uploads (Excel import / attachments). Default 120000.
# PORTAL_API_UPLOAD_TIMEOUT_MS=120000
# Must match API SESSION_COOKIE_NAME (chhata_session).
SESSION_COOKIE_NAME=chhata_session
# Auth: same-origin BFF `/api/v1/*` → Nest. Session cookie `chhata_session` is set on the portal origin
# (http://localhost:3000 locally, https://portal.npchhata.com in production).
# Municipality identity (inlined at build time). Shamli defaults shown.
# NEXT_PUBLIC_ULB_NAME=Nagar Palika Parishad Shamli
# NEXT_PUBLIC_ULB_NAME_HI=नगर पालिका परिषद शामली
# NEXT_PUBLIC_ULB_TOWN=Shamli
# NEXT_PUBLIC_ULB_DISTRICT=Shamli
# NEXT_PUBLIC_ULB_WEBSITE_HOST=nppshamli.in
# NEXT_PUBLIC_ULB_CODE=800645
# NEXT_PUBLIC_SURVEY_PARCEL_DIGITS=5
