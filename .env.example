# Optional root env for `docker compose --profile app`.
# Local `pnpm dev:api` / `pnpm dev:portal` use:
#   apps/api/.env
#   apps/portal/.env
#
# Copy: cp .env.example .env
# Never commit real secrets.

# Host ports when another ULB stack is already using 5433/6380/1025/8025.
# Keep these in sync with apps/api/.env (DATABASE_URL / REDIS_URL).
SHAMLI_PG_PORT=5434
SHAMLI_REDIS_PORT=6381
SHAMLI_MAILPIT_SMTP_PORT=1026
SHAMLI_MAILPIT_UI_PORT=8026

SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
SESSION_COOKIE_NAME=shamli_session
SEED_ADMIN_EMAIL=sikarwar2010@gmail.com
SEED_ADMIN_PASSWORD=change-me-seed-admin-password
SEED_ADMIN_NAME=Super Admin
