{
  "name": "sdv-nppshamli-apps",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "node scripts/ensure-local-ports.mjs && turbo run dev --ui=stream",
    "dev:api": "node scripts/ensure-local-ports.mjs && turbo run dev --filter=api --ui=stream",
    "dev:web": "node scripts/ensure-local-ports.mjs && turbo run dev --filter=web --ui=stream",
    "dev:portal": "node scripts/ensure-local-ports.mjs && turbo run dev --filter=portal --ui=stream",
    "dev:check-ports": "node scripts/ensure-local-ports.mjs",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "e2e": "turbo e2e",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:prod:config": "docker compose -f docker-compose.prod.yml --env-file .env.production.example config",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:seed": "pnpm --filter api prisma:seed"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.9",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "engines": {
    "node": ">=22.13"
  }
}
