# Paste this into Dokploy → Compose → Environment.
# Dokploy writes it as `.env` beside docker-compose.prod.yml.
# Replace every CHANGE_ME / example host. Do not commit real secrets.
#
# Do not set DATABASE_URL, REDIS_URL, CORS_ORIGIN, PUBLIC_APP_URL,
# ATOM_RETURN_URL, ATOM_CALLBACK_URL, or API_INTERNAL_URL here —
# docker-compose.prod.yml derives them from the values below.
# Portal/web reach Nest at http://shamli-api:4000 (unique Compose alias).
#
# Passwords for POSTGRES_PASSWORD and REDIS_PASSWORD must not contain
# @ : / # ? (they are interpolated into connection URLs).

NODE_ENV=production

# Public HTTPS origins (no trailing slash). Map these in Dokploy Domains.
PUBLIC_WEB_URL=https://www.example.com
PUBLIC_PORTAL_URL=https://portal.example.com

# Postgres (internal Docker DNS: postgres:5432)
POSTGRES_USER=shamli
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=shamli

# Redis (internal Docker DNS: redis:6379)
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# Auth — REQUIRED. If missing, Docker prints:
#   warning: The "SESSION_SECRET" variable is not set. Defaulting to a blank string.
# and the API container exits before the health check passes.
# Generate: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_at_least_32_random_chars
# Session cookie + lifetime. Use chhata_session locally and in production
# (Secure is set automatically when PUBLIC_APP_URL is https).
SESSION_COOKIE_NAME=shamli_session
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=604800
# Argon2id password hashing.
ARGON2_MEMORY_KB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# CSRF double-submit cookie for authenticated mutating requests.
CSRF_COOKIE_NAME=csrf_token

# Super Admin seed — required. The API container runs this on every start
# (idempotent: upserts the same email, does not create duplicates).
# SUPER_ADMIN_EMAIL / SUPER_ADMIN_PASSWORD are accepted as aliases.
# Never put a real production password in git.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

REQUEST_BODY_LIMIT=25mb
IMPORT_MAX_FILE_SIZE_MB=50

# Payments — production Atom AIPay
PAYMENT_PROVIDER=atom
ATOM_BASE_URL=https://payment1.atomtech.in
ATOM_AUTH_URL=https://payment1.atomtech.in/ots/aipay/auth
ATOM_CHECKOUT_CDN=https://psa.atomtech.in/staticdata/ots/js/atomcheckout.js
ATOM_CHECKOUT_ENV=prod
ATOM_MERCH_ID=
ATOM_PASSWORD=
ATOM_API_SECRET_KEY=
ATOM_AES_REQUEST_KEY=
ATOM_AES_REQUEST_IV=
ATOM_AES_RESPONSE_KEY=
ATOM_AES_RESPONSE_IV=
ATOM_REQ_HASH_KEY=
ATOM_RESP_HASH_KEY=
ATOM_PRODUCT=NSE

# --- Object storage (MinIO) — survey/property images -----------------------
# MinIO-compatible storage (pgsty/silo) runs as an internal service (not
# published). Root credentials are for administration only. The one-shot
# `minio-init` service creates the bucket and the least-privilege API user
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY on every deploy (docs/storage/minio.md);
# MINIO_ACCESS_KEY must differ from MINIO_ROOT_USER.
# Secrets ≥ 8 chars, no spaces. Never reuse the local dev defaults.
MINIO_ROOT_USER=CHANGE_ME_minio_admin_user
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_admin_password
MINIO_ACCESS_KEY=CHANGE_ME_api_access_key
MINIO_SECRET_KEY=CHANGE_ME_strong_api_secret_key
MINIO_BUCKET=shamli-survey-images
STORAGE_DRIVER=minio
# Signs short-lived /api/v1/files links (defaults to SESSION_SECRET when unset).
# Must be ≥32 chars in production. Generate: openssl rand -base64 48
STORAGE_SIGNING_SECRET=CHANGE_ME_at_least_32_random_chars
# Hosts the image migration may download from (comma-separated, https only).
IMAGE_MIGRATION_ALLOWED_HOSTS=backend.sdvedutech.in
# Background migration of imported images into MinIO (seconds; 0 disables).
IMAGE_MIGRATION_INTERVAL_SECONDS=300

# --- Municipality identity --------------------------------------------------
# GIS Survey Id prefix and parcel width (800645-003-00001-001-H).
ULB_CODE=800645
SURVEY_PARCEL_DIGITS=5
# Website built into the web image: shamli (nppshamli.in) or chhata.
SITE_ID=shamli
